import express from "express";
import fs from "fs";
import path from "path";
import multer from "multer";
import { processarXMLs } from "./processador.js";

const app = express();
const PORTA = 3000;

const upload = multer({ dest: path.join(process.cwd(), "uploads") });

app.use(express.json());

const arquivoFila = path.join(
  process.cwd(),
  "saida-teste",
  "fila-validacao.json"
);

app.get("/", (_req, res) => {
  res.send(`
    <!DOCTYPE html>
    <html lang="pt-BR">
      <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Conformidade IBS/CBS</title>
        <style>
          body {
            font-family: Arial, sans-serif;
            margin: 0;
            background: #f5f5f5;
            color: #222;
          }
          header {
            background: #222;
            color: white;
            padding: 24px 40px;
          }
          main {
            max-width: 1200px;
            margin: 30px auto;
            padding: 0 20px;
          }
          .resumo {
            background: white;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 20px;
          }
          .item {
            background: white;
            padding: 22px;
            border-radius: 10px;
            margin-bottom: 16px;
            box-shadow: 0 1px 4px rgba(0,0,0,.08);
          }
          .dados {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 12px;
            margin: 15px 0;
          }
          .campo {
            background: #f7f7f7;
            padding: 12px;
            border-radius: 6px;
          }
          .rotulo {
            font-size: 12px;
            color: #666;
          }
          .Valor {
            font-weight: bold;
            margin-top: 4px;
          }
          textarea {
            width: 100%;
            min-height: 70px;
            box-sizing: border-box;
            margin-top: 12px;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 6px;
          }
          button {
            padding: 11px 24px;
            margin: 10px 8px 0 0;
            border: 0;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
          }
          .sim {
            background: #2e7d32;
            color: white;
          }
          .nao {
            background: #c62828;
            color: white;
          }
          .status {
            margin-top: 10px;
            font-weight: bold;
          }
        </style>
      </head>
      <body>
        <header>
          <h1>Conformidade IBS/CBS</h1>
          <div>Fila de valida?f?'????T?f?????,??"??f?'??,???f????s????z??f?'????T?f????s??.??f?'??,?s?f??s?,??f?'????T?f?????,??"??f?'??,???f????s????z??f?'????T?f????s??.??f?'??,?s?f??s?,?o de enquadramento tribut?f?'????T?f?????,??"??f?'??,???f????s????z??f?'????T?f????s??.??f?'??,?s?f??s?,?rio</div>
        </header>

        <main>
          <div class="resumo">
            <h2>Valida?f?'????T?f?????,??"??f?'??,???f????s????z??f?'????T?f????s??.??f?'??,?s?f??s?,??f?'????T?f?????,??"??f?'??,???f????s????z??f?'????T?f????s??.??f?'??,?s?f??s?,?es pendentes</h2>
            <div id="quantidade">Carregando...</div>
          </div>

          <div id="lista"></div>
        </main>

        <script>
          async function carregarFila() {
            const resposta = await fetch("/api/fila-validacao");
            const fila = await resposta.json();

            document.getElementById("quantidade").textContent =
              fila.length + " Produto(s) aguardando valida?f?'????T?f?????,??"??f?'??,???f????s????z??f?'????T?f????s??.??f?'??,?s?f??s?,??f?'????T?f?????,??"??f?'??,???f????s????z??f?'????T?f????s??.??f?'??,?s?f??s?,?o.";

            const lista = document.getElementById("lista");

            if (!fila.length) {
              lista.innerHTML = "<div class='item'>N?f?'????T?f?????,??"??f?'??,???f????s????z??f?'????T?f????s??.??f?'??,?s?f??s?,?o h?f?'????T?f?????,??"??f?'??,???f????s????z??f?'????T?f????s??.??f?'??,?s?f??s?,? valida?f?'????T?f?????,??"??f?'??,???f????s????z??f?'????T?f????s??.??f?'??,?s?f??s?,??f?'????T?f?????,??"??f?'??,???f????s????z??f?'????T?f????s??.??f?'??,?s?f??s?,?es pendentes.</div>";
              return;
            }

            lista.innerHTML = fila.map((item, indice) => {
              const regra = item.regras && item.regras.length
                ? item.regras.join(", ")
                : "Sem regra candidata";

              return \`
                <div class="item">
                  <h2>\${item.Produto}</h2>

                  <div class="dados">
                    <div class="campo">
                      <div class="rotulo">cProd</div>
                      <div class="Valor">\${item.cProd}</div>
                    </div>

                    <div class="campo">
                      <div class="rotulo">NCM</div>
                      <div class="Valor">\${item.ncm}</div>
                    </div>

                    <div class="campo">
                      <div class="rotulo">Itens</div>
                      <div class="Valor">\${item.Itens}</div>
                    </div>

                    <div class="campo">
                      <div class="rotulo">Base de c?f?'????T?f?????,??"??f?'??,???f????s????z??f?'????T?f????s??.??f?'??,?s?f??s?,?lculo</div>
                      <div class="Valor">R$ \${Number(item.base).toLocaleString("pt-BR", {minimumFractionDigits: 2})}</div>
                    </div>
                  </div>

                  <p><strong>Regra candidata:</strong> \${regra}</p>
                  <p><strong>Motivo:</strong> \${item.motivo}</p>

                  <textarea id="justificativa-\${indice}" placeholder="Justificativa (opcional)"></textarea>

                  <div>
                    <button class="sim" onclick="validar(\${indice}, 'SIM')">SIM ?f?'????T?f?????,??"??f?'??,?s?f??s?,??f?'????T?f??s?,??f?'?,??f???,?s?,??f????,??f?'??,?s?f??s?,??f?'????T?f??s?,??f?'?,??f????s??.??f??s?,??f?'??,?s?f??s?,? enquadra</button>
                    <button class="nao" onclick="validar(\${indice}, 'NAO')">N?f?'????T?f?????,??"??f?'??,???f????s????z??f?'????T?f????s??,??f?'?,??f???,?s?,??f???,?z?,?O ?f?'????T?f?????,??"??f?'??,?s?f??s?,??f?'????T?f??s?,??f?'?,??f???,?s?,??f????,??f?'??,?s?f??s?,??f?'????T?f??s?,??f?'?,??f????s??.??f??s?,??f?'??,?s?f??s?,? n?f?'????T?f?????,??"??f?'??,???f????s????z??f?'????T?f????s??.??f?'??,?s?f??s?,?o enquadra</button>
                  </div>

                  <div class="status" id="status-\${indice}"></div>
                </div>
              \`;
            }).join("");

            window.filaAtual = fila;
          }

          async function validar(indice, resposta) {
            const item = window.filaAtual[indice];
            const justificativa =
              document.getElementById("justificativa-" + indice).value;

            const regraId = item.regras && item.regras.length
              ? item.regras[0]
              : null;

            if (!regraId) {
              alert("Este item n?f?'????T?f?????,??"??f?'??,???f????s????z??f?'????T?f????s??.??f?'??,?s?f??s?,?o possui regra candidata.");
              return;
            }

            const retorno = await fetch("/api/validar", {
              method: "POST",
              headers: {
                "Content-Type": "application/json"
              },
              body: JSON.stringify({
                ncm: item.ncm,
                cProd: item.cProd,
                regraId,
                resposta,
                autor: "Nilva",
                justificativa
              })
            });

            const dados = await retorno.json();
            const status = document.getElementById("status-" + indice);

            if (retorno.ok) {
              status.textContent = "Valida?f?'????T?f?????,??"??f?'??,???f????s????z??f?'????T?f????s??.??f?'??,?s?f??s?,??f?'????T?f?????,??"??f?'??,???f????s????z??f?'????T?f????s??.??f?'??,?s?f??s?,?o gravada. ReProcessamento necess?f?'????T?f?????,??"??f?'??,???f????s????z??f?'????T?f????s??.??f?'??,?s?f??s?,?rio para atualizar a fila.";
              status.style.color = "#2e7d32";
            } else {
              status.textContent = dados.erro || "Erro ao gravar valida?f?'????T?f?????,??"??f?'??,???f????s????z??f?'????T?f????s??.??f?'??,?s?f??s?,??f?'????T?f?????,??"??f?'??,???f????s????z??f?'????T?f????s??.??f?'??,?s?f??s?,?o.";
              status.style.color = "#c62828";
            }
          }

          carregarFila();
        </script>
      </body>
    </html>
  `);
});
app.post("/api/validar", (req, res) => {
  try {
    const { ncm, cProd, regraId, resposta, autor, justificativa } = req.body;

    if (!ncm || !cProd || !regraId || !["SIM", "NAO"].includes(resposta)) {
      return res.status(400).json({
        erro: "Dados de valida?f?'????T?f?????,??"??f?'??,???f????s????z??f?'????T?f????s??.??f?'??,?s?f??s?,??f?'????T?f?????,??"??f?'??,???f????s????z??f?'????T?f????s??.??f?'??,?s?f??s?,?o inv?f?'????T?f?????,??"??f?'??,???f????s????z??f?'????T?f????s??.??f?'??,?s?f??s?,?lidos."
      });
    }

    const arquivoEmpresa = path.join(process.cwd(), "empresa.json");
    const empresa = JSON.parse(fs.readFileSync(arquivoEmpresa, "utf-8"));

    if (!Array.isArray(empresa.validacoes)) {
      empresa.validacoes = [];
    }

    empresa.validacoes = empresa.validacoes.filter(
      (v: any) => !(v.ncm === ncm && v.cProd === cProd && v.regraId === regraId)
    );

    empresa.validacoes.push({
      ncm,
      cProd,
      regraId,
      resposta,
      autor: autor || "Sistema",
      data: new Date().toISOString().slice(0, 10),
      ...(justificativa ? { justificativa } : {})
    });

    fs.writeFileSync(
      arquivoEmpresa,
      JSON.stringify(empresa, null, 2),
      "utf-8"
    );

    res.json({
      sucesso: true,
      mensagem: "Valida?f?'????T?f?????,??"??f?'??,???f????s????z??f?'????T?f????s??.??f?'??,?s?f??s?,??f?'????T?f?????,??"??f?'??,???f????s????z??f?'????T?f????s??.??f?'??,?s?f??s?,?o gravada com sucesso."
    });
  } catch (erro) {
    console.error("Erro ao gravar valida?f?'????T?f?????,??"??f?'??,???f????s????z??f?'????T?f????s??.??f?'??,?s?f??s?,??f?'????T?f?????,??"??f?'??,???f????s????z??f?'????T?f????s??.??f?'??,?s?f??s?,?o:", erro);

    res.status(500).json({
      erro: "N?f?'????T?f?????,??"??f?'??,???f????s????z??f?'????T?f????s??.??f?'??,?s?f??s?,?o foi poss?f?'????T?f?????,??"??f?'??,???f????s????z??f?'????T?f????s??.??f?'??,?s?f??s?,?vel gravar a valida?f?'????T?f?????,??"??f?'??,???f????s????z??f?'????T?f????s??.??f?'??,?s?f??s?,??f?'????T?f?????,??"??f?'??,???f????s????z??f?'????T?f????s??.??f?'??,?s?f??s?,?o."
    });
  }
});

app.post("/api/importar", upload.array("arquivos", 500), (req, res) => {
  try {
    const arquivos = (req.files ?? []) as Express.Multer.File[];

    if (arquivos.length === 0) {
      return res.status(400).json({
        erro: "Nenhum arquivo XML foi enviado."
      });
    }

    const pastaXml = path.join(process.cwd(), "uploads", `lote-${Date.now()}`);
    fs.mkdirSync(pastaXml, { recursive: true });

    for (const arquivo of arquivos) {
      const destino = path.join(pastaXml, arquivo.originalname);
      fs.renameSync(arquivo.path, destino);
    }

    const resultado = processarXMLs(
      pastaXml,
      path.join(process.cwd(), "empresa.json"),
      path.join(process.cwd(), "saida-teste"),
      path.join(process.cwd(), "data", "base-normativa.json"),
    );

    res.json({
      sucesso: true,
      xmls: resultado.xmls,
      documentos: resultado.documentos,
      descartados: resultado.descartados,
      indicadores: resultado.indicadores,
      pendencias: resultado.fila.length,
    });
  } catch (erro) {
    console.error("Erro ao importar XMLs:", erro);

    res.status(500).json({
      erro: "N?o foi poss?vel processar os XMLs.",
      detalhe: erro instanceof Error ? erro.message : String(erro),
    });
  }
});
app.get("/api/dashboard", (_req, res) => {
  try {
    const arquivo = path.join(process.cwd(), "saida-teste", "indicadores.json");
    const dados = JSON.parse(fs.readFileSync(arquivo, "utf-8"));
    res.json(dados);
  } catch (erro) {
    console.error("Erro ao ler indicadores.json:", erro);
    res.status(500).json({
      erro: "N?o foi poss?vel carregar o dashboard."
    });
  }
});

